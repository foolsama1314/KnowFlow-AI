# ===== 应用 =====
APP_NAME=知枢 AI
DEBUG=false

# ===== 模型服务（国内大模型 API）=====
# LLM：摘要、问答、分类、实体关系抽取
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Embedding：文本向量化（需与 LLM 分开配置，可使用任意 OpenAI 兼容向量服务）
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024

# ===== 存储 =====
# 留空则使用 data/database/knowflow.db
DATABASE_URL=
# 留空则使用 Qdrant 本地嵌入式模式（data/qdrant），无需 Docker
QDRANT_URL=
QDRANT_COLLECTION=document_chunks

# ===== 处理参数 =====
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_UPLOAD_MB=200
DEFAULT_TOP_K=5
MAX_CONCURRENT_TASKS=2
